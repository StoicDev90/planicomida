---
import Layout from '@/layouts/Layout.astro';
import { getDb } from '@/lib/db';
import { formatAmount } from '@/lib/format';
import { fieldErrors } from '@/lib/http';
import { listToText } from '@/lib/list-text';
import { parseQty } from '@/lib/recipe-form';
import { addWeeks, isWeekStart } from '@/lib/week';
import { today, weekRangeLabel } from '@/lib/week-view';
import { AISLES } from '@/services/recipes';
import {
  addManualItem,
  deleteManualItem,
  getShoppingList,
  MANUAL_UNITS,
  ManualItemInput,
} from '@/services/shopping-list';

const user = Astro.locals.user!;
const requested = Astro.url.searchParams.get('semana');
const week = isWeekStart(requested) ? requested : today().weekStart;
const db = getDb();

let fields: Record<string, string> = {};
let draft = { name: '', qty: '', unit: '', aisle: 'Otros' };

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = String(form.get('action') ?? '');
  if (action === 'delete') {
    deleteManualItem(db, user.id, Number(form.get('id')));
    return Astro.redirect(`/app/lista?semana=${week}`, 303);
  }
  if (action === 'add') {
    draft = {
      name: String(form.get('name') ?? ''),
      qty: String(form.get('qty') ?? ''),
      unit: String(form.get('unit') ?? ''),
      aisle: String(form.get('aisle') ?? 'Otros'),
    };
    const qty = parseQty(draft.qty);
    const parsed = ManualItemInput.safeParse({
      name: draft.name,
      aisle: draft.aisle,
      ...(qty !== null ? { qty } : {}),
      ...(draft.unit ? { unit: draft.unit } : {}),
    });
    if (parsed.success) {
      addManualItem(db, user.id, week, parsed.data);
      return Astro.redirect(`/app/lista?semana=${week}#agregar`, 303);
    }
    fields = fieldErrors(parsed.error);
    Astro.response.status = 400;
  }
}

const list = getShoppingList(db, user.id, week);
const label = weekRangeLabel(week);
const shareText = listToText(list, label);
const prevWeek = addWeeks(week, -1);
const nextWeek = addWeeks(week, 1);
---

<Layout title="Lista del súper · PlaniComida">
  <main
    id="shopping-list"
    data-user={user.id}
    data-week={week}
    data-share-text={shareText}
    class="mx-auto max-w-6xl px-4 py-8 md:px-6 md:py-12"
  >
    <h1 class="font-display text-head leading-[0.95] uppercase">Lista del súper</h1>

    <nav aria-label="Semanas" class="mt-6 flex flex-wrap items-center gap-3">
      <a
        href={`/app/lista?semana=${prevWeek}`}
        class="btn bg-surface text-ink hover:bg-ink hover:text-paper"
        aria-label="Semana anterior"
      >
        ◀
      </a>
      <p class="text-lead font-medium">{label}</p>
      <a
        href={`/app/lista?semana=${nextWeek}`}
        class="btn bg-surface text-ink hover:bg-ink hover:text-paper"
        aria-label="Semana siguiente"
      >
        ▶
      </a>
      <a href={`/app/planner?semana=${week}`} class="link inline-flex min-h-11 items-center">
        Volver al planner
      </a>
    </nav>

    <p class="mt-4 text-small text-muted">
      Cantidades para 1 persona por comida. Si comen más, multiplicá.
    </p>
    {list.customMeals.length > 0 && (
      <p class="mt-2 text-small text-muted">
        Comidas libres de la semana (no suman ingredientes): {list.customMeals.join(', ')}
      </p>
    )}

    <div data-toolbar class="mt-6 flex flex-wrap gap-x-6 gap-y-2" hidden>
      <button type="button" data-uncheck-all class="link min-h-11 font-medium">
        Destildar todo
      </button>
      <button type="button" data-share class="link min-h-11 font-medium">
        Compartir
      </button>
      <span
        data-share-status
        role="status"
        class="inline-flex min-h-11 items-center text-small text-muted"
      ></span>
    </div>

    {list.aisles.length === 0 ? (
      <p class="mt-10">
        No hay recetas planificadas esta semana.{' '}
        <a href={`/app/planner?semana=${week}`} class="link">
          Ir al planner
        </a>
      </p>
    ) : (
      <div class="mt-8 md:columns-2 md:gap-10 lg:columns-3">
        {list.aisles.map((group) => (
          <section class="mb-8 break-inside-avoid" aria-labelledby={`g-${group.aisle}`}>
            <h2 id={`g-${group.aisle}`} class="text-lead font-semibold">
              {group.aisle}
            </h2>
            <ul class="mt-2 space-y-1">
              {group.items.map((item, index) => (
                <li data-item data-index={index} class="flex items-center gap-2 bg-surface px-3">
                  <label class="flex min-h-12 flex-1 cursor-pointer items-center gap-3 py-2">
                    <input
                      type="checkbox"
                      data-check
                      data-key={item.key}
                      class="size-6 shrink-0 accent-accent"
                    />
                    <span data-name>
                      {item.name}
                      {formatAmount(item.qty, item.unit) && (
                        <span class="text-muted"> — {formatAmount(item.qty, item.unit)}</span>
                      )}
                      {item.manual && <span class="text-small text-muted"> · agregado</span>}
                    </span>
                  </label>
                  {item.manual && (
                    <form method="post">
                      <input type="hidden" name="action" value="delete" />
                      <input type="hidden" name="id" value={item.id} />
                      <button
                        type="submit"
                        class="link min-h-11 text-small"
                        aria-label={`Quitar ${item.name}`}
                      >
                        Quitar
                      </button>
                    </form>
                  )}
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    )}

    <section
      id="agregar"
      class="mt-12 bg-surface p-5 md:max-w-2xl"
      aria-labelledby="agregar-titulo"
    >
      <h2 id="agregar-titulo" class="font-medium">
        Agregar ítem
      </h2>
      <form
        method="post"
        class="mt-4 grid gap-4 md:grid-cols-[1fr_6rem_7rem_10rem_auto] md:items-end"
        novalidate
      >
        <input type="hidden" name="action" value="add" />
        <div>
          <label for="agregar-name" class="label">
            Qué
          </label>
          <input
            id="agregar-name"
            name="name"
            class="input bg-paper"
            required
            maxlength="60"
            value={draft.name}
            aria-invalid={fields.name ? 'true' : undefined}
            aria-describedby={fields.name ? 'agregar-name-error' : undefined}
          />
          {fields.name && (
            <p id="agregar-name-error" class="field-error">
              {fields.name}
            </p>
          )}
        </div>
        <div>
          <label for="agregar-qty" class="label">
            Cantidad
          </label>
          <input
            id="agregar-qty"
            name="qty"
            inputmode="decimal"
            class="input bg-paper"
            value={draft.qty}
            aria-invalid={fields.qty ? 'true' : undefined}
            aria-describedby={fields.qty ? 'agregar-qty-error' : undefined}
          />
          {fields.qty && (
            <p id="agregar-qty-error" class="field-error">
              {fields.qty}
            </p>
          )}
        </div>
        <div>
          <label for="agregar-unit" class="label">
            Unidad
          </label>
          <select id="agregar-unit" name="unit" class="input bg-paper">
            <option value="" selected={draft.unit === ''}>
              Sin unidad
            </option>
            {MANUAL_UNITS.map((u) => (
              <option value={u} selected={draft.unit === u}>
                {u}
              </option>
            ))}
          </select>
        </div>
        <div>
          <label for="agregar-aisle" class="label">
            Góndola
          </label>
          <select id="agregar-aisle" name="aisle" class="input bg-paper">
            {AISLES.map((a) => (
              <option value={a} selected={draft.aisle === a}>
                {a}
              </option>
            ))}
          </select>
        </div>
        <button type="submit" class="btn">
          Agregar
        </button>
      </form>
    </section>
  </main>
</Layout>

<style is:global>
  #shopping-list .is-checked {
    opacity: 0.55;
  }
  #shopping-list .is-checked [data-name] {
    text-decoration: line-through;
  }
</style>

<script>
  import { loadChecked, saveChecked, type KeyValueStorage } from '@/lib/checked-store';

  const root = document.querySelector<HTMLElement>('#shopping-list');
  if (root) {
    const userId = Number(root.dataset.user);
    const week = root.dataset.week!;
    let storage: KeyValueStorage | null = null;
    try {
      storage = window.localStorage;
    } catch {
      storage = null;
    }
    const checked = storage ? loadChecked(storage, userId, week) : new Set<string>();
    const boxes = [...root.querySelectorAll<HTMLInputElement>('input[data-check]')];
    const status = root.querySelector<HTMLElement>('[data-share-status]')!;

    /** No tachados en su orden original; tachados al final. */
    function reorder(list: Element) {
      const items = [...list.children] as HTMLElement[];
      items.sort(
        (a, b) =>
          Number(a.classList.contains('is-checked')) - Number(b.classList.contains('is-checked')) ||
          Number(a.dataset.index) - Number(b.dataset.index),
      );
      list.append(...items);
    }

    function apply(box: HTMLInputElement) {
      const item = box.closest<HTMLElement>('[data-item]')!;
      item.classList.toggle('is-checked', box.checked);
      reorder(item.parentElement!);
    }

    function persist() {
      if (storage) saveChecked(storage, userId, week, checked);
    }

    boxes.forEach((box) => {
      box.checked = checked.has(box.dataset.key!);
      apply(box);
      box.addEventListener('change', () => {
        if (box.checked) checked.add(box.dataset.key!);
        else checked.delete(box.dataset.key!);
        persist();
        apply(box);
      });
    });
    // Keys tachadas que ya no están en la lista se olvidan.
    for (const key of [...checked])
      if (!boxes.some((b) => b.dataset.key === key)) checked.delete(key);
    persist();

    root.querySelector('[data-uncheck-all]')!.addEventListener('click', () => {
      checked.clear();
      persist();
      boxes.forEach((box) => {
        box.checked = false;
        apply(box);
      });
    });

    root.querySelector('[data-share]')!.addEventListener('click', async () => {
      const text = root.dataset.shareText ?? '';
      try {
        if (navigator.share) {
          await navigator.share({ title: 'Lista del súper', text });
          return;
        }
        await navigator.clipboard.writeText(text);
        status.textContent = 'Lista copiada';
      } catch (error) {
        if ((error as Error).name === 'AbortError') return; // cerró el diálogo de compartir
        const area = document.createElement('textarea');
        area.className = 'input mt-4 h-64';
        area.readOnly = true;
        area.value = text;
        root.querySelector('[data-toolbar]')!.after(area);
        area.select();
        status.textContent = 'Copiá el texto de abajo';
      }
    });

    root.querySelector<HTMLElement>('[data-toolbar]')!.hidden = false;
  }
</script>
