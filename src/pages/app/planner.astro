---
import Layout from '@/layouts/Layout.astro';
import MealSlot from '@/components/MealSlot.astro';
import SlotPicker from '@/components/SlotPicker.astro';
import { getDb } from '@/lib/db';
import { isWeekStart } from '@/lib/week';
import { buildWeekView, today, weekRangeLabel } from '@/lib/week-view';
import { copyWeek, getWeekPlan } from '@/services/plan';

const user = Astro.locals.user!;
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const target = String(form.get('week') ?? '');
  const source = String(form.get('source') ?? '');
  if (!isWeekStart(target)) return Astro.redirect('/app/planner', 303);
  if (!isWeekStart(source) || source === target)
    return Astro.redirect(`/app/planner?semana=${target}`, 303);
  const { copied, skipped } = copyWeek(getDb(), user.id, target, source);
  return Astro.redirect(
    `/app/planner?semana=${target}&copiadas=${copied}&omitidas=${skipped}`,
    303,
  );
}
const current = today();
const requested = Astro.url.searchParams.get('semana');
const week = isWeekStart(requested) ? requested : current.weekStart;
const plan = getWeekPlan(getDb(), user.id, week);
const days = buildWeekView(plan);
const copiedParam = Astro.url.searchParams.get('copiadas');
const skippedCount = Number(Astro.url.searchParams.get('omitidas') ?? 0);
let copyMessage = '';
if (copiedParam !== null) {
  const n = Number(copiedParam);
  copyMessage = n === 1 ? 'Se copió 1 comida' : `Se copiaron ${n} comidas`;
  if (skippedCount === 1) copyMessage += ' · 1 receta borrada no se copió';
  if (skippedCount > 1) copyMessage += ` · ${skippedCount} recetas borradas no se copiaron`;
}
---

<Layout title="Planner · PlaniComida">
  <main class="mx-auto max-w-6xl px-4 py-8 md:px-6 md:py-12">
    <h1 class="font-display text-head leading-[0.95] uppercase">Planner</h1>

    <nav aria-label="Semanas" class="mt-6 flex flex-wrap items-center gap-3">
      <a
        href={`/app/planner?semana=${plan.prevWeek}`}
        class="btn bg-surface text-ink hover:bg-ink hover:text-paper"
        aria-label="Semana anterior"
      >
        ◀
      </a>
      <p class="text-lead font-medium">{weekRangeLabel(week)}</p>
      <a
        href={`/app/planner?semana=${plan.nextWeek}`}
        class="btn bg-surface text-ink hover:bg-ink hover:text-paper"
        aria-label="Semana siguiente"
      >
        ▶
      </a>
      {week !== current.weekStart && (
        <a href="/app/planner" class="link min-h-11 inline-flex items-center">
          Hoy
        </a>
      )}
    </nav>

    <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-2">
      <form method="post">
        <input type="hidden" name="week" value={week} />
        <input type="hidden" name="source" value={plan.prevWeek} />
        <button type="submit" class="link min-h-11 font-medium">
          Copiar semana anterior
        </button>
      </form>
      <a
        href={`/app/lista?semana=${week}`}
        class="link inline-flex min-h-11 items-center font-medium"
      >
        Ver lista de compras
      </a>
    </div>
    {copyMessage && (
      <p role="status" class="mt-4 bg-surface px-4 py-3">
        {copyMessage}
      </p>
    )}

    <ol class="mt-8 grid gap-6 md:grid-cols-2 lg:grid-cols-7 lg:gap-3">
      {days.map((d) => (
        <li class:list={['space-y-2', { 'max-lg:order-first': d.isToday }]}>
          <h2 class="font-medium">
            {d.label}
            {d.isToday && <span class="text-accent"> · Hoy</span>}
          </h2>
          {d.slots.map((slot) => (
            <MealSlot week={week} day={d.day} dayLabel={d.label} view={slot} />
          ))}
        </li>
      ))}
    </ol>

    <SlotPicker />
  </main>
</Layout>
