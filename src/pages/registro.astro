---
import Layout from '@/layouts/Layout.astro';
import { getDb } from '@/lib/db';
import { setSessionCookie } from '@/lib/session-cookie';
import { registerFlow } from '@/services/auth-flows';

let values = { name: '', email: Astro.url.searchParams.get('email') ?? '' };
let fields: Record<string, string> = {};
let message = '';

if (Astro.request.method === 'POST') {
  const form = Object.fromEntries(await Astro.request.formData());
  values = { name: String(form.name ?? ''), email: String(form.email ?? '') };
  const result = await registerFlow(getDb(), form);
  if (result.ok) {
    setSessionCookie(Astro.cookies, result.token, result.expiresAt);
    return Astro.redirect('/app/planner', 303);
  }
  fields = result.fields ?? {};
  message = result.message;
  Astro.response.status = result.status;
}
---

<Layout title="Crear cuenta · PlaniComida">
  <main class="mx-auto flex min-h-dvh max-w-6xl flex-col px-4 py-8 md:px-6">
    <a href="/" class="font-display text-lead uppercase">
      PlaniComida
    </a>
    <section class="mx-auto mt-10 w-full max-w-sm md:mt-20" aria-labelledby="titulo">
      <h1 id="titulo" class="font-display text-head leading-[0.95] uppercase">
        Crear cuenta
      </h1>
      {message && (
        <p role="alert" class="field-error mt-4 text-body">
          {message}
        </p>
      )}
      <form method="post" class="mt-8 space-y-5" novalidate>
        <div>
          <label for="name" class="label">
            Nombre
          </label>
          <input
            id="name"
            name="name"
            class="input"
            autocomplete="name"
            required
            maxlength="60"
            value={values.name}
            aria-invalid={fields.name ? 'true' : undefined}
            aria-describedby={fields.name ? 'name-error' : undefined}
          />
          {fields.name && (
            <p id="name-error" class="field-error">
              {fields.name}
            </p>
          )}
        </div>
        <div>
          <label for="email" class="label">
            Email
          </label>
          <input
            id="email"
            name="email"
            type="email"
            class="input"
            autocomplete="email"
            required
            value={values.email}
            aria-invalid={fields.email ? 'true' : undefined}
            aria-describedby={fields.email ? 'email-error' : undefined}
          />
          {fields.email && (
            <p id="email-error" class="field-error">
              {fields.email}
            </p>
          )}
        </div>
        <div>
          <label for="password" class="label">
            Contraseña
          </label>
          <input
            id="password"
            name="password"
            type="password"
            class="input"
            autocomplete="new-password"
            required
            minlength="8"
            aria-invalid={fields.password ? 'true' : undefined}
            aria-describedby={fields.password ? 'password-error' : undefined}
          />
          {fields.password && (
            <p id="password-error" class="field-error">
              {fields.password}
            </p>
          )}
          <p class="mt-1.5 text-small text-muted">Mínimo 8 caracteres.</p>
        </div>
        <button type="submit" class="btn w-full">
          Crear cuenta
        </button>
      </form>
      <p class="mt-6">
        ¿Ya tenés cuenta?{' '}
        <a href="/login" class="link">
          Ingresá
        </a>
      </p>
    </section>
  </main>
</Layout>
